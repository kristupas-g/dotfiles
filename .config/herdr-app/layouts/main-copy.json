{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.15"
  },
  "type": "row",
  "theme": "misty-mountains",
  "ui_font": "Iowan Old Style",
  "font": "Iosevka Nerd Font Mono",
  "font_size": 15,
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "crest"
          },
          "size": {
            "px": 36
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces-pinned"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "chat-agents",
                "props": {
                  "replaces": {
                    "mod": "agents"
                  }
                }
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "prs",
              "type": "block",
              "content": {
                "mod": "prs"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          },
          "hidden": true
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs-icons"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "input"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 3,
                  "gap": 2,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "herdr-nvim",
                        "props": {
                          "replaces": {
                            "mod": "files"
                          },
                          "panel_width_was": {
                            "px": 368
                          },
                          "panel_width": 300
                        }
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "gitview",
                        "props": {
                          "replaces": {
                            "mod": "changes"
                          }
                        }
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 300
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "status-bar"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "gradient": [
      "#22201c",
      "#141312"
    ],
    "angle": 180
  },
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "floating": [
    {
      "id": "herdr-nvim-sync",
      "content": {
        "mod": "herdr-nvim",
        "props": {
          "role": "sync"
        }
      },
      "edge": "bottom",
      "align": "end"
    },
    {
      "id": "new-chat-commands",
      "content": {
        "mod": "new-chat",
        "props": {
          "role": "commands"
        }
      },
      "edge": "bottom",
      "align": "start"
    },
    {
      "id": "space-tabs",
      "edge": "bottom",
      "align": "start",
      "content": {
        "mod": "space-tabs"
      }
    },
    {
      "id": "git-actions",
      "content": {
        "mod": "git-actions"
      },
      "edge": "bottom",
      "align": "center"
    },
    {
      "id": "kube-commands",
      "content": {
        "mod": "kube",
        "props": {
          "role": "commands"
        }
      },
      "edge": "bottom",
      "align": "center"
    },
    {
      "id": "thanos-commands",
      "content": {
        "mod": "thanos",
        "props": {
          "role": "commands"
        }
      },
      "edge": "bottom",
      "align": "center"
    }
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "terminal_menu": "chat-menu"
}
